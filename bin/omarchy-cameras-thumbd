#!/usr/bin/python3
"""Keep a rolling thumbnail on disk for each ONVIF camera passed in.

    omarchy-cameras-thumbd <interval>          # specs on stdin, one per line
    <name>=<rtsp-url>=<user>

Frigate renders a JPEG per camera and serves it at latest.jpg; a bare ONVIF
camera has no such thing. ONVIF does define GetSnapshotUri, but it is not
dependable — cameras that advertise one and then answer HTTP 500 to every
request, authenticated or not, are common. So a frame is pulled out of the
RTSP stream instead.

mpv rather than ffmpeg, for one reason: a camera URL carries its password in
the userinfo, and ffmpeg accepts an input only as an argument, which puts that
password in /proc/<pid>/cmdline for every user on the machine to read. mpv can
take the URL as a playlist on an anonymous pipe and be told over its IPC
socket to write a frame to a fixed path, so the credential never reaches argv
and never touches disk. The camera list arrives on stdin for the same reason:
even without a password, the stream paths and usernames have no business in
the process table.

One long-lived player per camera, not one run per frame: the first frame waits
for a keyframe, which took 54s on one camera here, while later frames arrive on
schedule. Run this while thumbnails are on screen and stop it when they are
not; SIGTERM shuts every player down.
"""

import json
import os
import pathlib
import signal
import socket
import subprocess
import sys
import time

SERVICE = "omarchy-cameras"
ALLOWED_NAME = ("abcdefghijklmnopqrstuvwxyz"
                "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-")


def runtime_dir():
    """A private directory for frames and IPC sockets.

    $XDG_RUNTIME_DIR only, with no fallback: it is per-user and 0700, and a
    Wayland session cannot exist without it — the compositor socket lives
    there. Falling back to a world-writable /tmp would trade a guaranteed
    private directory for a predictable path someone else can get to first.

    The subdirectory is still checked rather than trusted. An existing entry
    is accepted only when it is a real directory, owned by this user, with no
    access for anyone else; a symlink or someone else's directory is refused
    rather than written through.
    """
    base = os.environ.get("XDG_RUNTIME_DIR")
    if not base:
        raise RuntimeError("XDG_RUNTIME_DIR is not set")
    path = pathlib.Path(base) / "omarchy-cameras"

    try:
        path.mkdir(mode=0o700, parents=False, exist_ok=False)
    except FileExistsError:
        info = path.lstat()                       # lstat: do not follow a symlink
        if not os.path.isdir(path) or os.path.islink(path):
            raise RuntimeError("%s is not a directory" % path)
        if info.st_uid != os.getuid():
            raise RuntimeError("%s is owned by uid %d" % (path, info.st_uid))
        if info.st_mode & 0o077:
            raise RuntimeError("%s is accessible to other users" % path)
    return path


def safe_name(name):
    """A camera name that can only ever be a file in the runtime directory.

    Callers pass a name already put through Cameras.slug(), but that guard
    lives in another language in another file, and a caller that does not know
    about it would otherwise get "../../.bashrc" turned into a path. Keeping
    the check next to the thing it protects costs one line.
    """
    if not name or name in (".", "..") or set(name) - set(ALLOWED_NAME):
        raise RuntimeError("unusable camera name: %r" % name)
    return name


def stream_url(rtsp, user):
    """The playable URL, with the password fetched from the keyring.

    Delegated to the ONVIF helper so there is one implementation of the
    percent-encoding, and so the password is read here rather than passed in.
    """
    if not user:
        return rtsp
    helper = pathlib.Path(__file__).with_name("omarchy-cameras-onvif")
    result = subprocess.run([str(helper), "stream-url"],
                            input=("%s\n%s\n" % (rtsp, user)).encode(),
                            capture_output=True, check=False)
    resolved = result.stdout.decode().strip()
    return resolved or rtsp


class Camera:
    def __init__(self, name, url, directory):
        self.name = name
        self.url = url
        self.socket_path = directory / (".%s.sock" % name)
        self.out = directory / ("%s.jpg" % name)
        self.process = None
        self.conn = None

    def start(self):
        # The URL goes down a pipe as a one-line playlist. Anything passed as
        # an argument would be readable in the process table.
        read_fd, write_fd = os.pipe()
        os.write(write_fd, (self.url + "\n").encode())
        os.close(write_fd)
        os.set_inheritable(read_fd, True)

        self.socket_path.unlink(missing_ok=True)
        self.process = subprocess.Popen(
            ["mpv", "--playlist=/dev/fd/%d" % read_fd,
             "--input-ipc-server=%s" % self.socket_path,
             "--rtsp-transport=tcp", "--vf=scale=-2:180",
             "--screenshot-format=jpg", "--screenshot-jpeg-quality=80",
             "--vo=null", "--no-audio", "--profile=low-latency",
             "--idle=no", "--really-quiet"],
            pass_fds=(read_fd,),
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        os.close(read_fd)

    def grab(self):
        """Ask for one frame. Silent failure is normal while a stream is still
        opening, which can take the better part of a minute."""
        if self.conn is None:
            if not self.socket_path.exists():
                return
            try:
                self.conn = socket.socket(socket.AF_UNIX)
                self.conn.settimeout(2)
                self.conn.connect(str(self.socket_path))
            except OSError:
                self.conn = None
                return
        command = {"command": ["screenshot-to-file", str(self.out), "video"]}
        try:
            self.conn.sendall((json.dumps(command) + "\n").encode())
        except OSError:
            self.conn = None

    def alive(self):
        return self.process is not None and self.process.poll() is None

    def stop(self):
        if self.conn is not None:
            try: self.conn.close()
            except OSError: pass
        if self.process is not None and self.process.poll() is None:
            self.process.terminate()
        self.socket_path.unlink(missing_ok=True)


def main(argv):
    if not argv:
        sys.stderr.write("usage: omarchy-cameras-thumbd <interval> "
                         "< specs\n")
        return 2
    interval = max(0.5, float(argv[0]))

    # Specs on stdin, never argv. The caller closes the pipe when it is done.
    specs = argv[1:] if len(argv) > 1 else sys.stdin.read().split("\n")

    directory = runtime_dir()
    cameras = []
    for spec in specs:
        spec = spec.strip()
        if not spec:
            continue
        name, _, rest = spec.partition("=")
        rtsp, _, user = rest.rpartition("=")
        if name and rtsp:
            cameras.append(
                Camera(safe_name(name), stream_url(rtsp, user), directory))
    if not cameras:
        return 0

    running = True

    def shutdown(*_):
        nonlocal running
        running = False
    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)

    for camera in cameras:
        camera.start()
    try:
        while running:
            for camera in cameras:
                if camera.alive():
                    camera.grab()
            # Sleep in slices so a signal is acted on promptly rather than
            # after a whole interval.
            deadline = time.monotonic() + interval
            while running and time.monotonic() < deadline:
                time.sleep(0.2)
    finally:
        for camera in cameras:
            camera.stop()
        for camera in cameras:
            if camera.process is not None:
                try: camera.process.wait(timeout=3)
                except subprocess.TimeoutExpired: camera.process.kill()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
