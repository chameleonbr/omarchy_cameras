#!/bin/bash
# Open one camera stream fullscreen. Layer 2 of the plugin: Wayland has no
# window embedding, so the focused view is a real mpv window rather than
# something painted inside omarchy-shell.
#
# Usage: omarchy-cameras-view <name> <stream-url> [onvif-user]
#
# With a user, the password is fetched from the keyring and spliced into the
# URL here, so cameras.json never has to hold it.

set -euo pipefail

name="${1:?usage: omarchy-cameras-view <name> <stream-url> [onvif-user]}"
stream="${2:?usage: omarchy-cameras-view <name> <stream-url> [onvif-user]}"
user="${3:-}"

if [[ -n "$user" ]]; then
  # Failure here is not fatal: an open camera still plays, and mpv reports the
  # 401 far more clearly than this script could.
  stream="$("$(dirname "$0")/omarchy-cameras-onvif" stream-url "$stream" --user "$user" 2>/dev/null || echo "$stream")"
fi

# --profile=low-latency drops mpv's buffering to near zero; without it an RTSP
# feed sits seconds behind, which defeats the point of looking at a camera.
# --rtsp-transport=tcp because UDP tears badly over Wi-Fi and most cameras
# support both.
#
# No --fs, and the app id is left as plain `mpv` on purpose. Omarchy already
# floats, centers and sizes class `mpv` at 875x600, which is the window this
# wants; asking for fullscreen on top of that rule made the two fight, and
# every change in the video stream re-triggered the fight and threw the window
# back to fullscreen. See the README for a rule that parks it in a corner.
#
# --force-window=immediate maps the window before the first frame arrives.
# Frigate's MJPEG endpoint can take several seconds to produce one, and
# without this the click appears to do nothing until it does.
#
# --loop-file=inf reopens the stream instead of closing the window when the
# feed drops. Cameras and NVRs drop connections routinely, and a viewer that
# vanishes on its own is worse than one that reconnects.
#
# The window opens at Omarchy's centered floating size. `f` is mpv's own
# built-in fullscreen toggle, so the only thing missing was saying so — hence
# the opening OSD line. --osd-playing-msg fires once when playback starts,
# which is exactly when the window appears.
#
# The stream is handed over as a one-line playlist on a pipe, never as an
# argument. A camera URL carries its password in the userinfo, and argv is
# world-readable through /proc — so the URL only ever exists in this shell's
# memory and on an anonymous fd that dies with the player. It never reaches
# the process table and never touches disk.
exec mpv \
  --playlist=<(printf '%s\n' "$stream") \
  --force-window=immediate \
  --profile=low-latency \
  --rtsp-transport=tcp \
  --hwdec=auto-safe \
  --no-osc \
  --keep-open=no \
  --loop-file=inf \
  --osd-playing-msg="${name}          f  fullscreen     q  close" \
  --osd-playing-msg-duration=4000 \
  --osd-font-size=26 \
  --title="omarchy-cameras: ${name}"
