#!/usr/bin/python3
"""ONVIF discovery and stream lookup for the Omarchy cameras plugin.

Standard library only: the three SOAP envelopes this needs are fixed strings,
and a generated client would pull in a dependency tree to build the same
three. Prints JSON on stdout, which the QML side reads off a Process.

  omarchy-cameras-onvif discover [--timeout 3]
  omarchy-cameras-onvif find <host[:port]>
  omarchy-cameras-onvif probe <host[:port]|xaddr> [--user admin]  # pw on stdin
  omarchy-cameras-onvif stream-url <rtsp> [--user admin]

`probe` stashes the password in the session keyring under
(service=omarchy-cameras, key=onvif-<host>) and leaves it out of its output,
so the credential never reaches cameras.json. `stream-url` reads it back and
splices it into the URL, which is how omarchy-cameras-view gets a playable
address without the password ever being written down.
"""

import argparse
import base64
import concurrent.futures
import hashlib
import ipaddress
import json
import os
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid
import xml.etree.ElementTree as ET
from datetime import datetime, timezone

WSDL_DISCOVERY = "http://schemas.xmlsoap.org/ws/2005/04/discovery"
SECRET_SERVICE = "omarchy-cameras"

PROBE_TEMPLATE = """<?xml version="1.0" encoding="UTF-8"?>
<e:Envelope xmlns:e="http://www.w3.org/2003/05/soap-envelope"
            xmlns:w="http://schemas.xmlsoap.org/ws/2004/08/addressing"
            xmlns:d="http://schemas.xmlsoap.org/ws/2005/04/discovery"
            xmlns:dn="http://www.onvif.org/ver10/network/wsdl">
  <e:Header>
    <w:MessageID>uuid:{message_id}</w:MessageID>
    <w:To e:mustUnderstand="true">urn:schemas-xmlsoap-org:ws:2005:04:discovery</w:To>
    <w:Action e:mustUnderstand="true">{discovery}/Probe</w:Action>
  </e:Header>
  <e:Body>
    <d:Probe><d:Types>dn:NetworkVideoTransmitter</d:Types></d:Probe>
  </e:Body>
</e:Envelope>"""


# --------------------------------------------------------------- XML helpers

# Anything answering on the local subnet reaches these parsers -- discovery
# sweeps every address -- so both limits below are about a hostile responder,
# not a broken camera.
MAX_XML = 1 << 20


def parse_xml(payload):
    """Parse a SOAP or WS-Discovery response from an untrusted device.

    xml.etree brings no defences of its own. Two are needed:

    A body with no cap can be streamed until memory runs out. And internal
    entity expansion is an amplifier -- 363 bytes of nested entities measured
    here expand to 1 MB in the tree, and every further level multiplies that by
    ten. No ONVIF response carries a DTD, so refusing one costs nothing and
    removes the whole class.

    External entities need no handling: ElementTree already refuses them
    ("undefined entity"), so a device cannot read a local file this way.

    Raises ParseError, which every caller already treats as "not a device".
    """
    if len(payload) > MAX_XML:
        raise ET.ParseError("response larger than %d bytes" % MAX_XML)
    if b"<!DOCTYPE" in payload or b"<!ENTITY" in payload:
        raise ET.ParseError("response declares a DTD")
    return ET.fromstring(payload)


def local_name(tag):
    """Tag without its namespace. ONVIF devices disagree about prefixes and
    even about which namespace revision they answer in, so every lookup here
    matches on the local name rather than a fully qualified tag."""
    return tag.rsplit("}", 1)[-1]


def find_all(node, name):
    return [el for el in node.iter() if local_name(el.tag) == name]


def find_first(node, name):
    for el in node.iter():
        if local_name(el.tag) == name:
            return el
    return None


def text_of(node, name, default=""):
    el = find_first(node, name) if node is not None else None
    return (el.text or "").strip() if el is not None else default


# ------------------------------------------------------------ WS-Security

def password_digest(nonce, created, password):
    """Base64(SHA1(nonce + created + password)) — WS-Security UsernameToken
    Profile 1.0. `nonce` is the raw bytes; the envelope carries their base64.
    `created` must be the exact string written into <Created>."""
    digest = hashlib.sha1(nonce + created.encode() + password.encode()).digest()
    return base64.b64encode(digest).decode()


def security_header(user, password, nonce=None, created=None):
    if not user:
        return ""
    if nonce is None:
        nonce = os.urandom(16)
    if created is None:
        created = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    wsse = ("http://docs.oasis-open.org/wss/2004/01/"
            "oasis-200401-wss-wssecurity-secext-1.0.xsd")
    wsu = ("http://docs.oasis-open.org/wss/2004/01/"
           "oasis-200401-wss-wssecurity-utility-1.0.xsd")
    profile = ("http://docs.oasis-open.org/wss/2004/01/"
               "oasis-200401-wss-username-token-profile-1.0")
    soap_sec = ("http://docs.oasis-open.org/wss/2004/01/"
                "oasis-200401-wss-soap-message-security-1.0")
    return (
        f'<s:Header><wsse:Security xmlns:wsse="{wsse}">'
        f'<wsse:UsernameToken>'
        f'<wsse:Username>{escape(user)}</wsse:Username>'
        f'<wsse:Password Type="{profile}#PasswordDigest">'
        f'{password_digest(nonce, created, password)}</wsse:Password>'
        f'<wsse:Nonce EncodingType="{soap_sec}#Base64Binary">'
        f'{base64.b64encode(nonce).decode()}</wsse:Nonce>'
        f'<wsu:Created xmlns:wsu="{wsu}">{created}</wsu:Created>'
        f'</wsse:UsernameToken></wsse:Security></s:Header>'
    )


def escape(value):
    return (str(value).replace("&", "&amp;").replace("<", "&lt;")
            .replace(">", "&gt;").replace('"', "&quot;"))


def soap_call(url, body, user="", password="", timeout=6):
    envelope = (
        '<?xml version="1.0" encoding="UTF-8"?>'
        '<s:Envelope xmlns:s="http://www.w3.org/2003/05/soap-envelope">'
        f'{security_header(user, password)}'
        f'<s:Body>{body}</s:Body></s:Envelope>'
    ).encode()
    request = urllib.request.Request(
        url, data=envelope,
        headers={"Content-Type": "application/soap+xml; charset=utf-8"})
    with urllib.request.urlopen(request, timeout=timeout) as response:
        # One byte over the cap is enough for parse_xml to reject it; reading
        # unbounded is what lets a device grow this process without limit.
        return parse_xml(response.read(MAX_XML + 1))


# ------------------------------------------------------------- discovery

def scope_value(scopes, kind):
    """Pull `onvif://www.onvif.org/<kind>/<value>` out of a Scopes string."""
    marker = "/" + kind + "/"
    for scope in scopes.split():
        index = scope.find(marker)
        if index != -1:
            return urllib.parse.unquote(scope[index + len(marker):])
    return ""


def parse_probe_matches(payload):
    """Devices described by one ProbeMatches response."""
    try:
        root = parse_xml(payload)
    except ET.ParseError:
        return []

    devices = []
    for match in find_all(root, "ProbeMatch"):
        addresses = text_of(match, "XAddrs")
        xaddr = next((a for a in addresses.split() if a.startswith("http")), "")
        if not xaddr:
            continue
        scopes = text_of(match, "Scopes")
        host = urllib.parse.urlparse(xaddr).hostname or ""
        devices.append({
            "xaddr": xaddr,
            "host": host,
            "name": scope_value(scopes, "name") or scope_value(scopes, "hardware") or host,
        })
    return devices


def local_networks():
    """IPv4 subnets this machine sits on, as (network, own address) pairs.

    /24 or smaller only: sweeping a /16 would be 65k probes, and a camera on
    one is a problem for the address field, not for discovery.
    """
    out = []
    try:
        raw = subprocess.run(["ip", "-j", "-4", "addr"],
                             capture_output=True, check=False, timeout=5).stdout
        interfaces = json.loads(raw or b"[]")
    except (OSError, ValueError, subprocess.SubprocessError):
        return out

    for interface in interfaces:
        if "LOOPBACK" in interface.get("flags", []):
            continue
        for address in interface.get("addr_info", []):
            if address.get("family") != "inet" or address.get("prefixlen", 0) < 24:
                continue
            try:
                network = ipaddress.ip_network(
                    "%s/%d" % (address["local"], address["prefixlen"]), strict=False)
            except ValueError:
                continue
            out.append((network, address["local"]))
    return out


def unicast_probe(host, attempts=2, timeout=1.2):
    """One WS-Discovery Probe straight at a host, rather than to the group.

    This is the path that actually works. The multicast reply arrives as an
    inbound packet with no matching outbound flow, so a default-deny firewall
    drops it — ufw does, out of the box — and plenty of Wi-Fi access points
    never forward the multicast in the first place. A unicast probe is an
    ordinary tracked exchange, and every camera that answers the group answers
    this too.

    One socket per host on purpose: a shared socket collects ICMP
    port-unreachable errors from every dead address and reports them on later
    sends, which silently skipped a third of the range.
    """
    message = PROBE_TEMPLATE.format(message_id=uuid.uuid4(), discovery=WSDL_DISCOVERY)
    for _ in range(attempts):
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        sock.settimeout(timeout)
        try:
            sock.sendto(message.encode(), (host, 3702))
            payload, _ = sock.recvfrom(65535)
            if b"ProbeMatch" in payload:
                return payload
        except OSError:
            pass
        finally:
            sock.close()
    return None


def multicast_probe(timeout):
    """The textbook probe. Kept because it costs one packet and answers
    instantly on a wired network with no firewall in the way."""
    message = PROBE_TEMPLATE.format(message_id=uuid.uuid4(), discovery=WSDL_DISCOVERY)
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 2)
    sock.settimeout(0.5)
    payloads = []
    try:
        sock.sendto(message.encode(), ("239.255.255.250", 3702))
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            try:
                payload, _ = sock.recvfrom(65535)
            except OSError:
                continue
            payloads.append(payload)
    except OSError:
        pass
    finally:
        sock.close()
    return payloads


def discover(timeout, workers=64):
    found = {}

    def collect(payload):
        for device in parse_probe_matches(payload):
            # Cameras answer a probe more than once; the xaddr is what every
            # later call is keyed on, so dedupe on it.
            found.setdefault(device["xaddr"], device)

    for payload in multicast_probe(timeout):
        collect(payload)

    hosts = []
    for network, own in local_networks():
        hosts += [str(h) for h in network.hosts() if str(h) != own]

    if hosts:
        with concurrent.futures.ThreadPoolExecutor(workers) as pool:
            for payload in pool.map(unicast_probe, hosts):
                if payload:
                    collect(payload)

    return sorted(found.values(), key=lambda d: d["name"].lower())


# ----------------------------------------------------------------- probe

                                          # ports/paths seen in the wild, most
                                          # likely first
# Every one of these was the answer on some camera on one home network.
DEVICE_PORTS = (80, 8000, 2020, 8899, 10000, 8080, 5000)
DEVICE_PATHS = ("/onvif/device_service", "/onvif/device")

# The unauthenticated call every ONVIF device answers, used purely to confirm
# that an address really is a device service.
HELLO = ('<tds:GetSystemDateAndTime '
         'xmlns:tds="http://www.onvif.org/ver10/device/wsdl"/>')


def resolve_service(target, timeout=2):
    """Turn `192.168.1.64`, `192.168.1.64:2020` or a full URL into the device
    service URL, by asking the likely ports until one answers as ONVIF.

    WS-Discovery is multicast, and plenty of networks — most Wi-Fi access
    points among them — never forward it between clients. Being able to name a
    camera by address is what makes ONVIF usable on those, and it also finds
    the port rather than assuming 80: of three cameras on one network here, one
    answered on 2020 and two on 80.
    """
    if target.startswith("http://") or target.startswith("https://"):
        return target if probe_service(target, timeout) else ""

    host, _, port = target.partition(":")
    ports = [int(port)] if port.isdigit() else list(DEVICE_PORTS)
    for candidate_port in ports:
        for path in DEVICE_PATHS:
            url = "http://%s:%d%s" % (host, candidate_port, path)
            if probe_service(url, timeout):
                return url
    return ""


def probe_service(url, timeout=2):
    try:
        root = soap_call(url, HELLO, timeout=timeout)
    except urllib.error.HTTPError as error:
        # GetSystemDateAndTime is meant to be unauthenticated, but a camera
        # that demands credentials for it has still identified itself as an
        # ONVIF endpoint — which is all this is asking.
        return error.code in (401, 403)
    except (urllib.error.URLError, OSError, ET.ParseError):
        return False
    return find_first(root, "GetSystemDateAndTimeResponse") is not None


def service_xaddrs(root):
    """Media and PTZ endpoints out of a GetCapabilities response."""
    services = {}
    for name in ("Media", "PTZ"):
        section = find_first(root, name)
        if section is None:
            continue
        addr = text_of(section, "XAddr")
        if addr:
            services[name] = addr
    return services


# What the viewer may be pointed at. A camera answers GetStreamUri with a URL
# of its choosing, and that URL becomes a playlist entry for mpv, which opens
# whatever scheme it is handed -- file:// included.
STREAM_SCHEMES = ("rtsp", "rtsps", "http", "https")


def check_stream_scheme(url):
    if urllib.parse.urlsplit(url).scheme.lower() not in STREAM_SCHEMES:
        raise RuntimeError("device returned a stream URI that is not RTSP: " + url)
    return url


def strip_credentials(url):
    """Drop any userinfo a camera echoes back into its own stream URL. The
    password belongs in the keyring, and cameras.json is a plain file."""
    parsed = urllib.parse.urlsplit(url)
    if not parsed.hostname:
        return url
    netloc = parsed.hostname
    if parsed.port:
        netloc += ":%d" % parsed.port
    return urllib.parse.urlunsplit(
        (parsed.scheme, netloc, parsed.path, parsed.query, parsed.fragment))


def with_credentials(url, user, password):
    """Splice credentials into a stream URL. Both halves are percent-encoded:
    passwords with `@` or `/` in them are common and would otherwise produce a
    URL that parses as some other host entirely."""
    parsed = urllib.parse.urlsplit(url)
    if not parsed.hostname or not user:
        return url
    userinfo = urllib.parse.quote(user, safe="")
    if password:
        userinfo += ":" + urllib.parse.quote(password, safe="")
    netloc = parsed.hostname
    if parsed.port:
        netloc += ":%d" % parsed.port
    return urllib.parse.urlunsplit(
        (parsed.scheme, userinfo + "@" + netloc, parsed.path, parsed.query,
         parsed.fragment))


def lookup_secret(host):
    result = subprocess.run(
        ["secret-tool", "lookup", "service", SECRET_SERVICE, "key", "onvif-%s" % host],
        capture_output=True, check=False)
    return result.stdout.decode().strip() if result.returncode == 0 else ""


def store_secret(host, password):
    if not password:
        return
    subprocess.run(
        ["secret-tool", "store", "--label=Omarchy camera %s" % host,
         "service", SECRET_SERVICE, "key", "onvif-%s" % host],
        input=password.encode(), check=False,
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def probe(target, user, password):
    xaddr = resolve_service(target)
    if not xaddr:
        raise RuntimeError("no ONVIF service answered at " + target)

    media_ns = 'xmlns:trt="http://www.onvif.org/ver10/media/wsdl"'
    schema_ns = 'xmlns:tt="http://www.onvif.org/ver10/schema"'

    capabilities = soap_call(
        xaddr,
        '<tds:GetCapabilities xmlns:tds="http://www.onvif.org/ver10/device/wsdl">'
        '<tds:Category>All</tds:Category></tds:GetCapabilities>',
        user, password)
    services = service_xaddrs(capabilities)
    media = services.get("Media")
    if not media:
        raise RuntimeError("device advertises no Media service")

    profiles = soap_call(media, f"<trt:GetProfiles {media_ns}/>", user, password)
    tokens = [el.get("token") for el in find_all(profiles, "Profiles") if el.get("token")]
    if not tokens:
        raise RuntimeError("device advertises no media profiles")

    # ponytail: first profile. On every camera seen so far that is the main
    # stream; the substream, when there is one, comes later in the list.
    stream = soap_call(
        media,
        f'<trt:GetStreamUri {media_ns} {schema_ns}><trt:StreamSetup>'
        '<tt:Stream>RTP-Unicast</tt:Stream>'
        '<tt:Transport><tt:Protocol>RTSP</tt:Protocol></tt:Transport>'
        f'</trt:StreamSetup><trt:ProfileToken>{escape(tokens[0])}</trt:ProfileToken>'
        '</trt:GetStreamUri>',
        user, password)
    uri = text_of(find_first(stream, "MediaUri") or stream, "Uri")
    if not uri:
        raise RuntimeError("device returned no stream URI")

    host = urllib.parse.urlparse(xaddr).hostname or ""
    device_info = None
    try:
        device_info = soap_call(
            xaddr,
            '<tds:GetDeviceInformation '
            'xmlns:tds="http://www.onvif.org/ver10/device/wsdl"/>',
            user, password)
    except (urllib.error.URLError, ET.ParseError, OSError):
        pass  # A name is a nicety; the camera still works without one.

    name = text_of(device_info, "Name") if device_info is not None else ""
    store_secret(host, password)

    return {
        "name": name or host,
        "host": host,
        "xaddr": xaddr,
        "rtsp": check_stream_scheme(strip_credentials(uri)),
        "user": user,
        "ptz": "PTZ" in services,
    }


# ------------------------------------------------------------------ main

def main(argv=None):
    parser = argparse.ArgumentParser(prog="omarchy-cameras-onvif")
    commands = parser.add_subparsers(dest="command", required=True)

    discover_cmd = commands.add_parser("discover")
    discover_cmd.add_argument("--timeout", type=float, default=2.0)

    probe_cmd = commands.add_parser("probe")
    # Either a device-service URL from discovery, or a plain address the user
    # typed: 192.168.1.64, or 192.168.1.64:2020.
    probe_cmd.add_argument("target")
    probe_cmd.add_argument("--user", default="")

    find_cmd = commands.add_parser("find")
    find_cmd.add_argument("target")

    # The URL and username arrive on stdin, one per line. Neither is a secret
    # on its own, but a stream path and the account watching it have no more
    # business in the process table than the password does.
    commands.add_parser("stream-url")

    args = parser.parse_args(argv)

    if args.command == "discover":
        json.dump({"devices": discover(args.timeout)}, sys.stdout)
        sys.stdout.write("\n")
        return 0

    if args.command == "find":
        xaddr = resolve_service(args.target)
        json.dump({"xaddr": xaddr} if xaddr
                  else {"error": "no ONVIF service answered at " + args.target},
                  sys.stdout)
        sys.stdout.write("\n")
        return 0 if xaddr else 1

    if args.command == "stream-url":
        rtsp = sys.stdin.readline().rstrip("\n")
        user = sys.stdin.readline().rstrip("\n")
        host = urllib.parse.urlsplit(rtsp).hostname or ""
        print(with_credentials(rtsp, user, lookup_secret(host)))
        return 0

    # Read the password off stdin so it never lands in argv, where every
    # other process on the machine could read it out of /proc.
    password = sys.stdin.readline().strip() if not sys.stdin.isatty() else ""
    try:
        json.dump({"camera": probe(args.target, args.user, password)}, sys.stdout)
    except Exception as error:  # noqa: BLE001 - the UI shows whatever went wrong
        json.dump({"error": str(error)}, sys.stdout)
        sys.stdout.write("\n")
        return 1
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
